{
  "env": {
    "GOMAXPROCS": "2",
    "GOFLAGS": "-p=2",
    "GOMEMLIMIT": "1GiB",
    "JAVA_TOOL_OPTIONS": "-Xmx768m -XX:ActiveProcessorCount=2",
    "NODE_OPTIONS": "--max-old-space-size=1536",
    "MAKEFLAGS": "-j2"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "wk guard-bash",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "wk guard-edit",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
