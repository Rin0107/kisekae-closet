{
  "name": "kisekae-closet",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "sh scripts/limit.sh 2G 2 vite build",
    "typecheck": "sh scripts/limit.sh 2G 2 tsc",
    "lint": "sh scripts/limit.sh 2G 2 eslint . --max-warnings 0 && prettier --check src tests scripts *.config.ts",
    "format": "prettier --write src tests scripts *.config.ts",
    "test": "sh scripts/limit.sh 2G 2 vitest run --coverage",
    "e2e": "sh scripts/limit.sh 3G 2 playwright test",
    "shots": "SHOTS=1 npm run e2e -- closet",
    "guards": "node scripts/deps-guard.mjs && node scripts/data-guard.mjs && node scripts/egress-guard.mjs && node scripts/db-guard.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run guards",
    "verify-ship": "WK_SHIP=1 npm run verify",
    "fuzz": "sh scripts/limit.sh 2G 2 vitest run --testNamePattern fuzz",
    "mutate": "sh scripts/limit.sh 3G 2 node scripts/mutate.mjs",
    "formal": "sh scripts/formal.sh",
    "db:local": "wrangler d1 migrations apply DB --local",
    "bundle": "npm run build && sh scripts/limit.sh 2G 2 wrangler deploy --dry-run --outdir bundle && mv bundle/index.js bundle/worker.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "qs": "6.16.2"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true
  }
}
